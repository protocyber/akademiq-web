# =============================================================================
# AkademiQ Web — Local development environment
# =============================================================================
# Copy this file to `.env` and edit values to fit your machine. The Makefile
# reads from `.env`. `.env` (and `.env.local`) are gitignored.
# =============================================================================

# Port the Next.js dev server binds to.
WEB_PORT=3000

# Standard Node mode flag. The Makefile sets this for you in production builds.
NODE_ENV=development
WEB_DEV_ORIGIN=localhost,akademiq.dev.sby.test,akademiq.10.201.0.25.nip.io

# Comma-separated list of extra hostnames allowed to access the dev server
# (HMR, fonts). Next.js 16+ blocks cross-origin dev requests by default.
# Only needed when fronting the dev server with a proxy (e.g. Traefik).
# Example: WEB_DEV_ORIGIN=akademiq.dev.sby.test
WEB_DEV_ORIGIN=

# Backend API base URLs. The web client talks directly to each service in
# phase 1 (no API gateway yet). Override per machine if you change ports.
NEXT_PUBLIC_IAM_BASE_URL=http://localhost:8081
NEXT_PUBLIC_BILLING_BASE_URL=http://localhost:8082
NEXT_PUBLIC_ACADEMIC_CONFIG_BASE_URL=http://localhost:8083
NEXT_PUBLIC_ACADEMIC_OPS_BASE_URL=http://localhost:8084
NEXT_PUBLIC_GRADING_BASE_URL=http://localhost:8086
