# =============================================================================
# AcademiQ Web — Local development environment
# =============================================================================
# Copy this file to `.env` and edit values to fit your machine. The Makefile
# reads from `.env`. `.env` (and `.env.local`) are gitignored.
# =============================================================================

# Port the Next.js dev server binds to.
WEB_PORT=3000

# Backend API base URL — bumps automatically when running through the parent
# repo's orchestrator since each service publishes its own port via the backend
# .env file. Override per machine if you change the API gateway port.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Standard Node mode flag. The Makefile sets this for you in production builds.
NODE_ENV=development
